{
  "name": "pixeo-insights",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone analytics and privacy-safe session replay service for Pixeo landings.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/tracker.ts --bundle --format=iife --platform=browser --target=es2020 --minify --outfile=dist/public/tracker.js",
    "lint": "eslint . --max-warnings=0",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.0.1",
    "fastify": "5.12.7",
    "jose": "5.9.6",
    "pg": "8.14.1",
    "rrweb": "2.0.0-alpha.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@types/node": "22.13.10",
    "@types/pg": "8.11.11",
    "esbuild": "0.25.1",
    "eslint": "9.22.0",
    "globals": "16.0.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0"
  }
}
