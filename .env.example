NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://pixeo_insights:replace-me@postgres:5432/pixeo_insights
POSTGRES_DB=pixeo_insights
POSTGRES_USER=pixeo_insights
POSTGRES_PASSWORD=replace-me
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_ISSUER=https://example-project.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated
PUBLIC_BASE_URL=https://insights.example.com
DASHBOARD_ORIGINS=https://app.example.com
TRUST_PROXY=true
REPLAY_DIR=/data/replays
REPLAY_SAMPLE_RATE=0.05
REPLAY_MAX_SESSION_BYTES=512000
REPLAY_MIN_FREE_DISK_BYTES=16106127360
REPLAY_MIN_FREE_MEMORY_RATIO=0.15
REPLAY_QUOTA_BYTES=10737418240
RETENTION_DAYS=7
CLEANUP_INTERVAL_MINUTES=60
COLLECT_RATE_LIMIT_PER_MINUTE=120
COLLECT_BODY_LIMIT_BYTES=655360
TRAEFIK_HOST=insights.example.com
TRAEFIK_NETWORK=n8n_default
TRAEFIK_CERT_RESOLVER=mytlschallenge
PIXEO_INSIGHTS_IMAGE=pixeo-insights:latest
